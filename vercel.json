{
    "version": 2,
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        },
        {
            "src": "server/index.js",
            "use": "@vercel/node",
            "config": {
                "includeFiles": "server/data/**"
            }
        }
    ],
    "rewrites": [
        {
            "source": "/__/auth/(.*)",
            "destination": "https://torquex-b2f0e.firebaseapp.com/__/auth/$1"
        },
        {
            "source": "/api/(.*)",
            "destination": "/server/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}